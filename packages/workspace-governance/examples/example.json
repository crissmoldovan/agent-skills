{
  "apiVersion": "workspace-governance/v1",
  "authorityId": "example-authority",
  "nodes": [
    {
      "id": "user",
      "kind": "user",
      "slug": "example-user",
      "label": "Example User",
      "parentId": null,
      "visibility": {
        "mode": "public",
        "readers": []
      }
    },
    {
      "id": "org",
      "kind": "domain",
      "slug": "demo",
      "label": "Demo",
      "parentId": "user"
    },
    {
      "id": "source",
      "kind": "namespace",
      "slug": "example",
      "label": "example",
      "parentId": "org"
    },
    {
      "id": "project",
      "kind": "project",
      "slug": "service",
      "label": "Service",
      "parentId": "source"
    },
    {
      "id": "repo",
      "kind": "repository",
      "slug": "api",
      "label": "API",
      "parentId": "project",
      "remote": "https://github.com/example/api"
    }
  ],
  "policies": [
    {
      "nodeId": "org",
      "settings": [
        {
          "key": "git.pullRequest",
          "merge": "replace",
          "value": true
        }
      ],
      "constraints": [
        {
          "id": "require-pr",
          "key": "git.pullRequest",
          "operator": "equals",
          "value": true
        }
      ]
    }
  ],
  "workflows": [
    {
      "nodeId": "org",
      "id": "feature",
      "settings": [],
      "constraints": [],
      "steps": [
        {
          "id": "test",
          "action": "repository.test",
          "inputs": {}
        }
      ]
    }
  ],
  "metadata": {}
}
