{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/crissmoldovan/agent-skills/workspace-governance/v2/config.schema.json",
  "title": "workspacectl v2 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentType", "catalog", "localState", "plans", "trustedRoots"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "documentType": { "const": "workspacectl/config" },
    "catalog": { "$ref": "#/definitions/store" },
    "localState": { "$ref": "#/definitions/store" },
    "plans": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": { "directory": { "$ref": "#/definitions/absolutePath" } }
    },
    "trustedRoots": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/absolutePath" }
    }
  },
  "definitions": {
    "absolutePath": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^/[^\\u0000\\r\\n]*$" },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "path"],
      "properties": {
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "path": { "$ref": "#/definitions/absolutePath" }
      }
    }
  }
}
