{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/crissmoldovan/agent-skills/workspace-governance/v2/open-result.schema.json",
  "title": "workspacectl open result",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "kind", "logicalTarget", "path", "context", "revisions", "hostAction"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["repository", "group"] },
    "logicalTarget": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "label"], "properties": { "kind": { "enum": ["repository", "group"] }, "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 } } },
    "path": { "type": ["string", "null"] },
    "context": { "type": "object" },
    "revisions": { "type": "object", "additionalProperties": false, "required": ["catalog", "localState"], "properties": { "catalog": { "$ref": "#/definitions/revision" }, "localState": { "$ref": "#/definitions/revision" } } },
    "hostAction": { "type": ["object", "null"] }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "repository" } }, "required": ["kind"] }, "then": { "required": ["repository", "workspace"], "properties": { "path": { "$ref": "#/definitions/absolutePath" } } } },
    { "if": { "properties": { "kind": { "const": "group" } }, "required": ["kind"] }, "then": { "required": ["group", "members", "coordinationWorkspace"] } }
  ],
  "definitions": {
    "absolutePath": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^/[^\\u0000\\r\\n]*$" },
    "revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
