{
  "version": 1,
  "kind": "signals",
  "useWhen": "choosing which model runs a piece of work, or setting routing up for this repository",
  "anyOf": [
    {
      "history": {
        "count": "agentDispatches",
        "atLeast": 10
      }
    },
    {
      "history": {
        "count": "workflowLaunches",
        "atLeast": 2
      }
    }
  ]
}
