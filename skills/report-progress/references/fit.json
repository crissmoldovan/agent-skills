{
  "version": 1,
  "kind": "signals",
  "useWhen": "delegating to agents, or ending a turn with work still running in the background",
  "anyOf": [
    {
      "history": {
        "count": "agentDispatches",
        "atLeast": 3
      }
    },
    {
      "history": {
        "count": "workflowLaunches",
        "atLeast": 1
      }
    },
    {
      "history": {
        "count": "backgroundCommands",
        "atLeast": 3
      }
    }
  ]
}
